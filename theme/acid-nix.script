# acid-nix — acid-duotone nix snowflake on black.
#
# Boot: logo fades in (~0.5s) and holds. The region under the logo shows
# a live tail of the last 5 console lines (via the patched
# Plymouth.SetBootOutputFunction — see plymouth-script-boot-output.patch);
# during shutdown the same tail surfaces stop-job culprits. When a LUKS
# passphrase is requested the tail hides and the password dialog takes
# its place (blinking cursor, asterisk bullets). A wrong passphrase
# shakes the logo; a correct one fades everything out to clean black
# (the retained handoff frame) until the greeter paints.
#
# NB: sprites survive only while referenced. Anything drawn from a
# callback must live in a top-level (global) variable — locals are
# collected when the callback returns and take their sprite with them.

dialog = null;
message = null;

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen.w = Window.GetWidth();
screen.h = Window.GetHeight();
min_dim = screen.w;
if (screen.h < min_dim)
  min_dim = screen.h;

# Box the logo is fitted into. Plymouth's scaler is a bare bilinear
# sample, so the build ships a ladder of pre-rendered sizes and the
# picker below (generated by theme.nix) takes the nearest one at or
# above the box — keeping the runtime downscale gentle enough not to
# alias the edges on high-DPI panels.
logo.box = Math.Int(min_dim * 0.26);
@logoPicker@

logo.src = Image(logo.file);
# Fit inside the box preserving aspect: a custom logo needn't be square.
logo.sw = logo.src.GetWidth();
logo.sh = logo.src.GetHeight();
if (logo.sw >= logo.sh) {
  logo.w = logo.box;
  logo.h = Math.Int(logo.box * logo.sh / logo.sw);
} else {
  logo.h = logo.box;
  logo.w = Math.Int(logo.box * logo.sw / logo.sh);
}
logo.image = logo.src.Scale(logo.w, logo.h);
logo.sprite = Sprite(logo.image);
logo.x = screen.w / 2 - logo.w / 2;
logo.y = Math.Int(screen.h * 0.36) - logo.h / 2;
logo.sprite.SetPosition(logo.x, logo.y, 1);

# Point sizes are fixed units, so on a high-DPI panel a hardcoded size
# renders a postage-stamp dialog. Track the panel instead: 1080p is the
# reference, and acidBoot.scale tunes it further. Clamped so a tiny
# framebuffer (or a mode we get before KMS settles) can't produce
# unreadable or zero-sized text.
ui.scale = (screen.h / 1080) * @uiScale@;
if (ui.scale < 0.7)
  ui.scale = 0.7;
if (ui.scale > 4)
  ui.scale = 4;

# Font family names are substituted at build time; the module ships the
# matching font files into the initrd (acidBoot.fontFiles).
font.label = "@promptFontName@ " + Math.Int(18 * ui.scale);
font.entry = "@promptFontName@ " + Math.Int(22 * ui.scale);
font.log = "@logFontName@ " + Math.Int(11 * ui.scale);

# Shared vertical anchor: dialog and log tail both live here.
content.y = logo.y + logo.h + Math.Int(140 * ui.scale);

#----------------------------------------------------------------- state

anim.enabled = @animEnabled@;
state.opacity = 0;
state.mode = "fadein";          # fadein -> hold -> fadeout -> hidden
state.had_password = 0;
state.dialog_up = 0;
state.grace = 0;                # frames: unlock-vs-retry decision window
state.shake = 0;                # frames of shake animation left
counter = 0;

# With animations off the logo is solid from the first frame and no
# refresh callback is registered at all — the static baseline, and the
# fewest moving parts when bisecting a splash that won't prompt.
if (!anim.enabled) {
  state.opacity = 1;
  state.mode = "hold";
  logo.sprite.SetOpacity(1);
}

#-------------------------------------------------------------- log tail

log.enabled = @logEnabled@;
log.count = 5;
log.visible = 1;
# Left-aligned lines in a narrower container that sits centered.
log.x = Math.Int(screen.w * 0.26);
# Safe defaults. The real measurements happen at the very bottom of this
# file, AFTER every callback is registered: measuring text means calling
# into pango/fontconfig, and anything that throws there would otherwise
# abort the script before the password dialog is ever wired up — leaving
# a logo on screen and nothing else, which is indistinguishable from a
# boot hang.
log.line_h = Math.Int(22 * ui.scale);
log.char_w = 8;
log.max_chars = 80;
for (i = 0; i < log.count; i++) {
  log.lines[i] = "";
  log.colors[i] = 0;
  log.sprites[i] = Sprite();
}

# Each line carries the dominant ANSI SGR foreground color the C side
# saw (31 red, 32 green, 33 yellow, ... 0 none), remapped to the logo's
# acid palette. systemd colors only the [ OK ]/[FAILED] tag, so the tag
# color classifies the whole line.
fun log_redraw() {
  if (!log.enabled)
    return 0;
  for (i = 0; i < log.count; i++) {
    log.c = log.colors[i];
    if (log.c == 31)
      log.image = Image.Text(log.lines[i], @logFailColor@, 1, font.log);
    else if (log.c == 32)
      log.image = Image.Text(log.lines[i], @logOkColor@, 1, font.log);
    else if (log.c == 33)
      log.image = Image.Text(log.lines[i], @logWarnColor@, 1, font.log);
    else
      log.image = Image.Text(log.lines[i], @logDefaultColor@, 1, font.log);
    log.sprites[i].SetImage(log.image);
    log.sprites[i].SetPosition(log.x, content.y + i * log.line_h, 2);
    # older lines dim toward the top of the tail
    log.sprites[i].SetOpacity(log.visible * (0.45 + 0.55 * (i + 1) / log.count));
  }
}

fun boot_output_callback(line, color) {
  if (String(line).Length() > log.max_chars)
    line = String(line).SubString(0, log.max_chars - 3) + "...";
  for (i = 0; i < log.count - 1; i++) {
    log.lines[i] = log.lines[i + 1];
    log.colors[i] = log.colors[i + 1];
  }
  log.lines[log.count - 1] = line;
  log.colors[log.count - 1] = color;
  log_redraw();
}
if (log.enabled)
  Plymouth.SetBootOutputFunction(boot_output_callback);

#--------------------------------------------------------------- refresh

fun refresh_callback() {
  counter++;

  if (state.mode == "fadein") {
    state.opacity += 0.04;
    if (state.opacity >= 1) {
      state.opacity = 1;
      state.mode = "hold";
    }
  }
  if (state.mode == "fadeout") {
    state.opacity -= 0.04;
    if (state.opacity <= 0) {
      state.opacity = 0;
      state.mode = "hidden";
    }
  }
  logo.sprite.SetOpacity(state.opacity);

  # Unlock-vs-retry: if no re-prompt arrives within the grace window
  # after the dialog closed, the passphrase was right — fade out.
  if (state.grace > 0) {
    state.grace--;
    if (state.grace == 0)
      state.mode = "fadeout";
  }

  # Damped horizontal shake on a failed attempt.
  if (state.shake > 0) {
    state.shake--;
    shake.offset = Math.Sin(state.shake / 1.2) * 16 * (state.shake / 30);
    logo.sprite.SetX(logo.x + Math.Int(shake.offset));
    if (state.shake == 0)
      logo.sprite.SetX(logo.x);
  }

  # Blinking cursor, only while the dialog is up (~0.6s on, ~0.4s off).
  if (state.dialog_up && dialog) {
    if ((counter % 50) < 30)
      dialog.cursor_sprite.SetOpacity(1);
    else
      dialog.cursor_sprite.SetOpacity(0);
  }
}
if (anim.enabled)
  Plymouth.SetRefreshFunction(refresh_callback);

#--------------------------------------------------------------- dialog

fun display_password_callback(prompt_text, bullet_count) {
  # A re-prompt inside the grace window means the last attempt failed.
  if (state.grace > 0) {
    state.grace = 0;
    state.shake = 30;
  }
  state.mode = "hold";
  state.opacity = 1;
  state.had_password = 1;
  state.dialog_up = 1;
  log.visible = 0;
  log_redraw();

  # Ignore the caller's prompt (systemd-cryptsetup names the disk) —
  # keep it generic.
  dialog.prompt_image = Image.Text("@promptText@", @promptColor@, 1, font.label);
  dialog.prompt_sprite = Sprite(dialog.prompt_image);
  dialog.prompt_sprite.SetPosition(
    screen.w / 2 - dialog.prompt_image.GetWidth() / 2,
    content.y, 2);

  bullets = "";
  for (i = 0; i < bullet_count; i++)
    bullets += "*";
  dialog.bullet_image = Image.Text(bullets, @entryColor@, 1, font.entry);
  dialog.cursor_image = Image.Text("_", @entryColor@, 1, font.entry);
  entry.w = dialog.bullet_image.GetWidth() + dialog.cursor_image.GetWidth();
  entry.x = screen.w / 2 - entry.w / 2;
  entry.y = content.y + dialog.prompt_image.GetHeight() + Math.Int(24 * ui.scale);

  dialog.bullet_sprite = Sprite(dialog.bullet_image);
  dialog.bullet_sprite.SetPosition(entry.x, entry.y, 2);
  dialog.cursor_sprite = Sprite(dialog.cursor_image);
  dialog.cursor_sprite.SetPosition(entry.x + dialog.bullet_image.GetWidth() + Math.Int(4 * ui.scale), entry.y, 2);
}

fun display_normal_callback() {
  dialog = null;
  state.dialog_up = 0;
  log.visible = 1;
  log_redraw();
  # Don't fade yet — wait out the grace window to see whether this was
  # a real unlock or a failed attempt about to re-prompt (LUKS KDF can
  # take a couple of seconds either way).
  if (state.had_password)
    state.grace = 200;
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

#-------------------------------------------------------------- messages

fun message_callback(text) {
  message.image = Image.Text(text, @msgColor@, 1, font.label);
  message.sprite = Sprite(message.image);
  message.sprite.SetPosition(
    screen.w / 2 - message.image.GetWidth() / 2,
    screen.h - message.image.GetHeight() - Math.Int(40 * ui.scale), 2);
}
Plymouth.SetMessageFunction(message_callback);

#------------------------------------------------- deferred measurements

# Everything above is registered by now, so if a font lookup misbehaves
# here it costs us tidy log-tail metrics and nothing else — the
# passphrase dialog is already wired up and will still appear.
if (log.enabled) {
  log.probe_h = (Image.Text("Ag", 1, 1, 1, 1, font.log)).GetHeight();
  if (log.probe_h > 0)
    log.line_h = log.probe_h + Math.Int(6 * ui.scale);

  log.probe_w = (Image.Text("MMMMMMMMMM", 1, 1, 1, 1, font.log)).GetWidth() / 10;
  if (log.probe_w >= 1) {
    log.char_w = log.probe_w;
    log.max_chars = Math.Int((screen.w - 2 * log.x) / log.char_w);
    if (log.max_chars < 8)
      log.max_chars = 8;
  }
}
