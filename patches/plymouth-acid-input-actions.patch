+/* Plymouth.RequestAction(name): drop /run/acid-boot/<name>.request so a
+ * systemd .path unit can act on it (power off, reboot to firmware, ...).
+ * The theme only signals intent; what each name does, and whether it is
+ * allowed at all, is decided by the units the system ships. Names are
+ * restricted to [a-z0-9-] so a script can never steer the path. */
+#define ACID_ACTION_DIR "/run/acid-boot"
+
+static script_return_t plymouth_request_action (script_state_t *state,
+                                                void           *user_data)
+{
+        char *name = script_obj_hash_get_string (state->local, "name");
+        char path[sizeof(ACID_ACTION_DIR) + 64];
+        size_t length;
+        int fd;
+        bool ok = false;
+
+        if (name == NULL)
+                return script_return_obj (script_obj_new_number (0));
+
+        length = strlen (name);
+        if (length == 0 || length > 32)
+                goto out;
+        for (size_t i = 0; i < length; i++) {
+                char c = name[i];
+                if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-'))
+                        goto out;
+        }
+
+        if (mkdir (ACID_ACTION_DIR, 0700) < 0 && errno != EEXIST)
+                goto out;
+
+        snprintf (path, sizeof(path), ACID_ACTION_DIR "/%s.request", name);
+        fd = open (path, O_WRONLY | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+        if (fd < 0)
+                goto out;
+        close (fd);
+        ok = true;
+out:
+        free (name);
+        return script_return_obj (script_obj_new_number (ok ? 1 : 0));
+}
+
+/* Plymouth.ClearEntry(count): erase the pending passphrase by sending
+ * `count` backspaces — the theme passes the character count it was last
+ * shown. Ctrl+U's line erase can't be reused: it walks the keyboard's
+ * line buffer, which Enter has already cleared when the theme acts on an
+ * Enter it swallowed.
+ * Deferred by a 1ms timer (the event loop asserts a non-zero timeout):
+ * the theme calls this from inside its own validate_input handler, and
+ * erasing inline would re-enter the script through display_password
+ * while it is still running. */
+typedef struct
+{
+        ply_keyboard_t *keyboard;
+        int             count;
+} clear_entry_request_t;
+
+static void on_clear_entry_timeout (void             *user_data,
+                                    ply_event_loop_t *loop)
+{
+        clear_entry_request_t *request = user_data;
+
+        for (int i = 0; i < request->count; i++)
+                ply_keyboard_backspace (request->keyboard);
+        free (request);
+}
+
+static script_return_t plymouth_clear_entry (script_state_t *state,
+                                             void           *user_data)
+{
+        script_lib_plymouth_data_t *data = user_data;
+        int count = script_obj_hash_get_number (state->local, "count");
+        clear_entry_request_t *request;
+
+        if (data->keyboard == NULL || ply_keyboard_backspace == NULL || count <= 0)
+                return script_return_obj (script_obj_new_number (0));
+
+        request = malloc (sizeof(clear_entry_request_t));
+        request->keyboard = data->keyboard;
+        request->count = count;
+        ply_event_loop_watch_for_timeout (ply_event_loop_get_default (), 0.001,
+                                          on_clear_entry_timeout, request);
+        return script_return_obj (script_obj_new_number (1));
+}
