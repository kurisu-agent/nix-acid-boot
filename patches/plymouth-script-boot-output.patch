 static void
+forward_boot_output_lines (ply_boot_splash_plugin_t *plugin,
+                           const char               *output,
+                           size_t                    size)
+{
+        size_t i;
+
+        /* Only touch script state while the script is genuinely live.
+         * start_animation() sets is_animating *after* start_script_animation()
+         * has filled these pointers in (script_state is assigned before
+         * script_plymouth_lib, so there is a window where the first is
+         * set and the second is still NULL), and stop_animation() clears
+         * is_animating *before* destroying them — and does not NULL them
+         * afterwards. Guarding on is_animating therefore closes both a
+         * NULL dereference on the way up and a use-after-free on the way
+         * down; the explicit NULL checks are belt and braces. Getting
+         * this wrong crashes plymouthd, which silently takes the
+         * passphrase prompt with it and looks exactly like a boot hang. */
+        if (!plugin->is_animating)
+                return;
+
+        if (plugin->script_state == NULL || plugin->script_plymouth_lib == NULL)
+                return;
+
+        if (script_obj_is_null (plugin->script_plymouth_lib->script_boot_output_func))
+                return;
+
+        for (i = 0; i < size; i++) {
+                char c = output[i];
+
+                /* strip ANSI/VT escape sequences (ESC to the terminating
+                 * letter), remembering the last SGR foreground color seen
+                 * on this line so the theme can style by severity */
+                if (plugin->script_ansi_skip) {
+                        if (c >= '0' && c <= '9') {
+                                plugin->script_ansi_code =
+                                        plugin->script_ansi_code * 10 + (c - '0');
+                        } else {
+                                if ((plugin->script_ansi_code >= 30 && plugin->script_ansi_code <= 37) ||
+                                    (plugin->script_ansi_code >= 90 && plugin->script_ansi_code <= 97))
+                                        plugin->script_line_color =
+                                                plugin->script_ansi_code % 60;
+                                plugin->script_ansi_code = 0;
+                                if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z'))
+                                        plugin->script_ansi_skip = 0;
+                        }
+                        continue;
+                }
+                if (c == '\033') {
+                        plugin->script_ansi_skip = 1;
+                        plugin->script_ansi_code = 0;
+                        continue;
+                }
+                /* '\n' ends a line; '\r' means the writer is about to
+                 * redraw the same line in place (systemd's "A stop job is
+                 * running for ... (5s / 1min 30s)" spinner does this once
+                 * a second). Both complete a line, but a '\r' one is
+                 * flagged so the theme can overwrite its predecessor
+                 * instead of scrolling. Without this the spinner never
+                 * terminates a line at all and every update accretes into
+                 * one long garbage string. */
+                if (c == '\n' || c == '\r') {
+                        if (ply_buffer_get_size (plugin->script_line_buffer) > 0) {
+                                script_lib_plymouth_on_boot_output (plugin->script_state,
+                                                                    plugin->script_plymouth_lib,
+                                                                    ply_buffer_get_bytes (plugin->script_line_buffer),
+                                                                    plugin->script_line_color,
+                                                                    c == '\r' ? 1 : 0);
+                                ply_buffer_clear (plugin->script_line_buffer);
+                        }
+                        if (c == '\n')
+                                plugin->script_line_color = 0;
+                        continue;
+                }
+                if (c > '\0' && c < ' ')
+                        continue;
+
+                /* A writer that redraws its line in place never sends a
+                 * newline — systemd's "A stop job is running for ...
+                 * (5s / 1min 30s)" ticks once a second that way — and the
+                 * console tty strips its carriage returns before we see
+                 * them, so the text would otherwise accrete into one
+                 * ever-growing string until something unrelated emits a
+                 * newline. Flush at a width no real line reaches, marked
+                 * as a replacement, so such a writer updates a single
+                 * line instead of growing one. */
+                if (ply_buffer_get_size (plugin->script_line_buffer) >= 240) {
+                        script_lib_plymouth_on_boot_output (plugin->script_state,
+                                                            plugin->script_plymouth_lib,
+                                                            ply_buffer_get_bytes (plugin->script_line_buffer),
+                                                            plugin->script_line_color,
+                                                            1);
+                        ply_buffer_clear (plugin->script_line_buffer);
+                }
+                ply_buffer_append_bytes (plugin->script_line_buffer, &c, 1);
+        }
+}
