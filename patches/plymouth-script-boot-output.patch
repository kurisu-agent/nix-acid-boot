+void script_lib_plymouth_on_boot_output (script_state_t             *state,
+                                         script_lib_plymouth_data_t *data,
+                                         const char                 *line,
+                                         int                         color,
+                                         int                         replace)
+{
+        script_obj_t *line_obj = script_obj_new_string (line);
+        script_obj_t *color_obj = script_obj_new_number (color);
+        script_obj_t *replace_obj = script_obj_new_number (replace);
+        script_return_t ret = script_execute_object (state,
+                                                     data->script_boot_output_func,
+                                                     NULL,
+                                                     line_obj,
+                                                     color_obj,
+                                                     replace_obj,
+                                                     NULL);
+
+        script_obj_unref (line_obj);
+        script_obj_unref (color_obj);
+        script_obj_unref (replace_obj);
+        script_obj_unref (ret.object);
+}
